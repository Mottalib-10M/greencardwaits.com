---
/**
 * Accueil (pilier, RECETTE §5), trame propre au site : bandeau des trois sources datées, H1 et chapeau replié, aussitôt
 * le simulateur « When will my green card come? », le paragraphe citable, puis le relevé du mois pour les six cases les
 * plus cherchées (avance ou recul), les plus grands mouvements du bulletin, les trois portes (bulletin, délais, frais),
 * l'erreur passée du modèle en chiffres, le texte et la FAQ.
 */
import PageLayout from '../layouts/PageLayout.astro';
import GreenCardTool from './calc/GreenCardTool';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/params';
import { CAT_SHORT, COUNTRY_LABEL, QUEUE_CATS, COUNTRIES, LATEST, cellAt, moveDays, type Cat, type Country } from '../lib/engine/cases';
import { PUBLISHED } from '../lib/engine/ptimes';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
import { displayDate } from '../lib/format';
import BT from '../data/backtest.json';
interface Props { lang: Locale }
const { lang } = Astro.props;
const es = lang === 'es';
const T = (en: string, sp: string) => (es ? sp : en);
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const faqs = x.faqs;
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const keys: SourceKey[] = ['vbIndex', 'vbOct2026', 'aosCharts', 'g1055', 'dosFees', 'uscisTimes', 'itData', 'uscisReport', 'cspaPolicy'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const r = (id: string) => (hasRoute(id, lang) ? route(id, lang) : route(id, 'en'));
const popular: Array<[Exclude<Cat, 'IR'>, Country, string]> = [['EB2', 'IN', 'eb-2-india'], ['EB3', 'IN', 'eb-3-india'], ['EB2', 'CN', 'eb-2-china'], ['F2A', 'ROW', 'f2a'], ['F4', 'PH', 'f4-philippines'], ['F1', 'MX', 'f1-mexico']];
const mv = (d: number | null) => (d === null ? '–' : Math.abs(d) < 1 ? T('unchanged', 'sin cambio') : `${d > 0 ? '▲' : '▼'} ${h.num(Math.round(Math.abs(d)))} ${T('days', 'días')}`);
// Plus grands mouvements du mois, toutes cases confondues.
const moves = QUEUE_CATS.flatMap((c) => COUNTRIES.map((k) => ({ c, k, d: moveDays(c, k) }))).filter((m) => m.d !== null && Math.abs(m.d) >= 1)
  .filter((m, i, a) => m.k === 'ROW' || cellAt(m.c, m.k, 'FAD') !== cellAt(m.c, 'ROW', 'FAD'))
  .sort((a, b) => Math.abs(b.d!) - Math.abs(a.d!)).slice(0, 5);
const cells = Object.values(BT.cases).flatMap((c: any) => c.cells).filter((c: any) => c.observed >= 12 && Number.isFinite(c.coverage));
const median = (a: number[]) => { const s = [...a].sort((p, q) => p - q); return s[Math.floor(s.length / 2)]; };
const cover = median(cells.map((c: any) => c.coverage));
const reliable = cells.filter((c: any) => c.reliable).length;
const doors = [
  { id: 'visa-bulletin', t: T('Visa Bulletin', 'Boletín de Visas'), d: T(`The ${h.month(LATEST)} cutoffs for every category and country, both charts, and 294 bulletins back to December 2001.`, `Las fechas de ${h.month(LATEST)} de cada categoría y país, las dos tablas y 294 boletines desde diciembre de 2001.`) },
  { id: 'processing-times', t: T('USCIS processing times', 'Tiempos de USCIS'), d: T(`Ranges published by USCIS on ${h.date(PUBLISHED)} for 90 field offices and the service centers, with a checker for your receipt date.`, `Rangos publicados por USCIS el ${h.date(PUBLISHED)} para 90 oficinas y los centros de servicio, con un verificador para su fecha de recibo.`) },
  { id: 'fees', t: T('2026 fees', 'Costos de 2026'), d: T(`Form G-1055, edition ${P.g1055_edition}: each path added up, paper and online, with the State Department visa fees.`, `Formulario G-1055, edición del ${P.g1055_edition}: cada trámite sumado, en papel y en línea, con las tarifas de visa.`) },
];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{T(`Visa Bulletin for ${h.month(LATEST)} · USCIS times of ${h.date(PUBLISHED)} · fees of ${P.g1055_edition}`, `Visa Bulletin de ${h.month(LATEST)} · tiempos de USCIS del ${h.date(PUBLISHED)} · tarifas del ${P.g1055_edition}`)}</p>
    <h1 class="mt-1 text-3xl font-bold text-navy-900 md:text-[2.5rem] md:leading-tight">{x.h1}</h1>
    <Clamp text={x.intro} lang={lang} id="clamp-intro" sentences={1} class="mt-2" />
    <p class="mt-1 text-sm text-navy-700"><a class="underline" href={route('method', lang)}>{label('method', lang)}</a> · <a class="underline" href={route('about', lang)}>{label('about', lang)}</a></p>
  </header>
  <section id="calculator" data-outil aria-label={T('Green card wait calculator', 'Calculadora de espera de la green card')}>
    <GreenCardTool client:load lang={lang} methodHref={route('method', lang)} feesHref={r('uscis-fee-calculator')} />
  </section>
  <section class="mt-8" aria-labelledby="short">
    <h2 id="short" class="text-2xl font-bold text-navy-900">{T('The short answer', 'La respuesta corta')}</h2>
    <p class="mt-3 text-navy-800">{x.resume}</p>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="month" data-chrome>
    <h2 id="month" class="text-2xl font-bold text-navy-900">{T(`${h.month(LATEST)}: the six most-searched cases`, `${h.month(LATEST)}: los seis casos más buscados`)}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map(([c, k, id]) => (
        <li class="rounded-lg border border-navy-200 bg-white p-4">
          <a class="font-semibold text-navy-900 underline" href={r(id)}>{CAT_SHORT[c]} · {COUNTRY_LABEL[lang][k]}</a>
          <p class="tabular-nums mt-1 font-serif text-2xl font-bold text-navy-900">{h.cell(cellAt(c, k, 'FAD'))}</p>
          <p class={`tabular-nums text-sm ${(moveDays(c, k) ?? 0) < 0 ? 'move-down' : 'text-navy-700'}`}>{mv(moveDays(c, k))} · {T('Dates for Filing', 'Presentación')}: {h.cell(cellAt(c, k, 'DFF'))}</p>
        </li>
      ))}
    </ul>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="changed" data-chrome>
    <h2 id="changed" class="text-2xl font-bold text-navy-900">{T('What moved the most this month', 'Lo que más se movió este mes')}</h2>
    <ol class="mt-4 space-y-2">
      {moves.map((m) => <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-navy-100 pb-2"><span class="text-navy-900">{CAT_SHORT[m.c]} · {COUNTRY_LABEL[lang][m.k]}</span><span class={`tabular-nums font-semibold ${m.d! < 0 ? 'move-down' : 'move-up'}`}>{mv(m.d)}</span></li>)}
    </ol>
    <p class="mt-3"><a class="font-medium text-accent-700 underline" href={r('visa-bulletin')}>{T(`Full ${h.month(LATEST)} bulletin`, `Boletín completo de ${h.month(LATEST)}`)}</a></p>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="doors" data-chrome>
    <h2 id="doors" class="text-2xl font-bold text-navy-900">{T('Three questions, three sources', 'Tres preguntas, tres fuentes')}</h2>
    <dl class="mt-4 grid gap-4 md:grid-cols-3">
      {doors.map((d) => <div class="rounded-lg border border-navy-200 p-4"><dt><a class="font-semibold text-navy-900 underline" href={r(d.id)}>{d.t}</a></dt><dd class="mt-1 text-sm text-navy-700">{d.d}</dd></div>)}
    </dl>
  </section>
  <aside class="mt-10 rounded-lg border border-accent-200 bg-accent-50/60 p-4 text-navy-900" data-chrome>
    <p class="font-semibold">{T('Our forecasts, graded', 'Nuestros pronósticos, calificados')}</p>
    <p class="mt-1 text-sm">{T(`Over ${h.num(cells.length)} back-tested cells (case × distance behind the cutoff), the forecast range held the real date a median ${h.pct(cover)} of the time. ${h.num(reliable)} cells pass our publication rule; the others show “no reliable forecast”.`, `En ${h.num(cells.length)} celdas probadas (caso × distancia a la fecha límite), el rango acertó la fecha real una mediana del ${h.pct(cover)} de las veces. ${h.num(reliable)} celdas cumplen nuestra regla; las demás muestran “sin pronóstico fiable”.`)} <a class="underline" href={route('method', lang)}>{T('Every number on the method page', 'Todas las cifras en la página de método')}</a></p>
  </aside>
  <div class="prose prose-slate mt-10 max-w-none border-t border-navy-200 pt-4">
    {parts.map((p) => <Fragment set:html={p} />)}
  </div>
</PageLayout>
