---
/** Pages de contenu (es) : un fichier de src/content/ = une page (CONTRIBUTING-PAGES.md). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() { return PAGES.filter((page) => page.es).map((page) => ({ params: { slug: page.es!.path }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="es" />
