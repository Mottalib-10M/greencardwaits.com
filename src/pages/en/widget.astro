---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, CONTACT_EMAIL, LAST_UPDATED, SITE_URL, SITE_NAMES, LEGAL, LANG_TAGS } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { displayDate } from '../../lib/format';
import { personSchema, organizationSchema, breadcrumbSchema, profilePageSchema, contactPageSchema } from '../../lib/seo';
const lang = 'en';
const upd = displayDate(LAST_UPDATED, LANG_TAGS[lang]);
---
<PageLayout title="Embed the Green Card Wait Calculator on Your Site" description="Embed the green card wait calculator free of charge by iframe: Visa Bulletin status, forecast range with past error, USCIS time and fees, in English or Spanish." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the green card calculator</h1><p class="mt-3 text-lg text-navy-700">For community organizations, employers’ HR pages and immigrant-focused publishers: paste the code once and the cutoffs update with every bulletin.</p></header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{`<iframe src="${SITE_URL}/embed/green-card-wait/" title="Green card wait calculator" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`}</code></pre>
    <p>Add <code>?lang=es</code> to the address for the Spanish version. Terms: the source link under the calculator stays visible and the calculator is not altered; it is provided without warranty and is not legal advice. The frame stores and measures nothing.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/green-card-wait/" title="Green card wait calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
